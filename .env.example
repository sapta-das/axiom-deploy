# Axiom compose deployment settings. Copy to .env, fill in, and keep it private:
#   cp .env.example .env && chmod 600 .env
# Every container reads this file; never commit it or bake it into an image.

# -- Images ----------------------------------------------------------------------------------
# The images to run, as scripts/push-images.sh printed them. One repository for all three:
AXIOM_CONTROL_IMAGE=docker.io/sapdas/axiom:control-b02b9b5
AXIOM_WORKER_IMAGE=docker.io/sapdas/axiom:worker-b02b9b5
AXIOM_PORTAL_IMAGE=docker.io/sapdas/axiom:portal-b02b9b5
# Or one repository per image under a registry namespace (used when the three above are unset):
# AXIOM_REGISTRY=docker.io/your-user
# AXIOM_VERSION=latest

# -- Access ----------------------------------------------------------------------------------
# The portal (and the API under /v1) listens on AXIOM_BIND:AXIOM_PORT. 127.0.0.1 keeps it on
# this machine; 0.0.0.0 opens it to the network.
AXIOM_BIND=127.0.0.1
AXIOM_PORT=8080
AXIOM_PORTAL_URL=http://localhost:8080
# One shared token for the portal and the API (at least 32 characters):
#   openssl rand -hex 32
AXIOM_API_TOKEN=
AXIOM_API_TOKEN_SUBJECT=pilot

# -- Axiom's database (bundled PostgreSQL) -------------------------------------------------
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# -- AWS: Glue, S3 and KMS -----------------------------------------------------------------
# Region of the Glue catalog and the S3 data. Credentials need read access to the Glue tables,
# their S3 objects and, for encrypted tables, kms:Decrypt (see README for a policy).
AXIOM_AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
# AWS_SESSION_TOKEN=
# Glue catalog account id, when it is not the credentials' own account:
# AXIOM_GLUE_CATALOG_ID=123456789012
# S3 SSE-C tables only (base64 AES-256 key and its MD5):
# AXIOM_S3_SSE_KEY=
# AXIOM_S3_SSE_MD5=

# -- OpenMetadata ----------------------------------------------------------------------------
OM_BASE_URL=https://openmetadata.example.com
# The Axiom bot's JWT (OpenMetadata: Settings → Bots).
OM_TOKEN=
# Which assets to copy, as JSON: services, databases or schemas (fully qualified names).
OM_SCOPE={"schemas": ["glue_prod.lakehouse.gold"]}
# OM_FRESHNESS_BUDGET_S=21600
# OM_RECONCILE_INTERVAL_S=3600

# -- Trino -----------------------------------------------------------------------------------
AXIOM_TRINO_ENDPOINT=https://trino.example.com:8443
AXIOM_TRINO_CATALOG=iceberg
AXIOM_TRINO_USER=axiom
# Password or JWT (either; both need an https endpoint):
AXIOM_TRINO_PASSWORD=
# AXIOM_TRINO_JWT=

# -- Sizing ----------------------------------------------------------------------------------
# DataFusion worker memory for one query, and its spill space.
AXIOM_DF_MEMORY_BYTES=4294967296
AXIOM_SCRATCH_SIZE=4g
